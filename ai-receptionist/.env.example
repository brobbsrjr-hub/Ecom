# Supabase (Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only. Used by Twilio webhooks and admin invites. Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# Anthropic
ANTHROPIC_API_KEY=
MODEL_SMS=claude-haiku-5-5
MODEL_VOICE=claude-opus-5-5

# Twilio (leave blank in dev: outbound texts are logged, webhooks return 503)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=

# Public base URL Twilio calls (used for webhook signature checks), no trailing slash
PUBLIC_BASE_URL=http://localhost:3000
